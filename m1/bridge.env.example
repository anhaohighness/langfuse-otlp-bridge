# 桥接层环境变量模板：复制为仓库根 .env 后填写（.env 已被 .gitignore 排除）。
# 密钥只存在于服务端部署系统（APIM named value / K8s secret / 云 KMS），从不下发设备。
# 每个区域、每个环境（dev / fieldtest / prod）一个 Langfuse 项目、一对密钥；
# 缺配置即失败，不跨区回退。

# 必填：完整 traces 端点（不依赖导出器自动追加路径）
LANGFUSE_TRACES_ENDPOINT=https://<langfuse-host>/api/public/otel/v1/traces

# 鉴权二选一：
# 方式 A（M1 与 M2 通用）：Basic base64(publicKey:secretKey)
#   生成：printf '%s' "$LF_PUBLIC_KEY:$LF_SECRET_KEY" | base64 -w0
LANGFUSE_AUTHORIZATION=
# 方式 B（仅 M1 forwarder 支持，自动拼 Basic；M2 Collector 只读方式 A）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# M1 监听地址；默认与 Collector 的 OTLP/HTTP 端口一致，探针命令无需改
BRIDGE_LISTEN_HOST=0.0.0.0
BRIDGE_LISTEN_PORT=4318

# 可选：内部令牌。设置后入站必须带 Authorization: Bearer <token>；
# M2 对应 collector 配置里注释的 bearertokenauth/apim。
BRIDGE_INBOUND_TOKEN=

# M1 重试与超时（仅对 429/5xx/超时重试，指数退避 + 抖动）
BRIDGE_MAX_RETRIES=3
BRIDGE_TIMEOUT_SECONDS=30